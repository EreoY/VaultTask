{
  "mcpServers": {
    "gitnexus": {
      "command": "gitnexus",
      "args": [
        "mcp"
      ],
      "timeout": 120000,
      "autoApprove": [
        "query",
        "impact",
        "context"
      ]
    },
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "timeout": 120000
    }
  }
}